# Debian-based host: k3s runs natively, managed by systemd. Included by the main
# Makefile — run targets from there. The heavy lifting is in install_k3s.sh.

.PHONY: platform_help install_k3s stop_k3s start_k3s uninstall_k3s

platform_help:
	@echo "k3s lifecycle (linux):"
	@echo "  make install_k3s         Bootstrap k3s + namespace; secret requires REGISTRY_USER + REGISTRY_PASS"
	@echo "  make stop_k3s            Stop k3s and ALL pod containers (k3s-killall.sh)"
	@echo "  make start_k3s           Start k3s (systemctl start k3s)"
	@echo "  make uninstall_k3s       Wipe k3s entirely (k3s-uninstall.sh)"
	@echo ""
	@echo "  Access: https://<vm-ip> (composed-ui hostPort 443)"

install_k3s:
	./install_k3s.sh

# killall, not `systemctl stop k3s`: stopping the service leaves the containers up.
stop_k3s:
	sudo /usr/local/bin/k3s-killall.sh

start_k3s:
	sudo systemctl start k3s

uninstall_k3s:
	sudo /usr/local/bin/k3s-uninstall.sh
