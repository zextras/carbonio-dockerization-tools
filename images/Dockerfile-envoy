FROM docker.io/envoyproxy/envoy:v1.27-latest
COPY --from=docker.io/hashicorp/consul:1.17 /bin/consul /usr/local/bin/consul
RUN apt-get update && apt-get install -y jq && rm -rf /var/lib/apt/lists/*

# Fake service-discover binary — returns a predefined bootstrap token
RUN printf '#!/bin/sh\necho "${BOOTSTRAP_TOKEN:-00000000-0000-0000-0000-000000000000}"\n' > /usr/local/bin/service-discover \
    && chmod +x /usr/local/bin/service-discover

COPY images/entrypoint.sh /usr/local/bin/entrypoint.sh

ENV SERVICE_NAME=""
ENV SETUP_SCRIPT=""
ENV TOKEN_FILE=""
ENV BOOTSTRAP_TOKEN="00000000-0000-0000-0000-000000000000"

ENTRYPOINT ["entrypoint.sh"]